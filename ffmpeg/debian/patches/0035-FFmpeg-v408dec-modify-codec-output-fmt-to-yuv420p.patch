+                for (j = 0; j < avctx->width; j+=2) {
+                    *v++ = src[0];
+                    *u++ = src[1];
+                    *y++ = src[2];
+                    *y++ = src[6];
+                    src += 8;
+                }
+            }
+        }
+    } else {
+        for (i = 0; i < avctx->height; i++) {
