@@ -53,27 +52,43 @@ static int v408_decode_frame(AVCodecCont
     y = pic->data[0];
     u = pic->data[1];
     v = pic->data[2];
-    a = pic->data[3];
 
-    for (i = 0; i < avctx->height; i++) {
